#!/usr/bin/env python3
"""Run this immutable managed release through its isolated Python environment."""

import os
import sys
from pathlib import Path


def main():
    release = Path(__file__).resolve().parent.parent
    if not (release / ".devflow-release.json").is_file():
        print("devflow: install a reviewed release before using this launcher", file=sys.stderr)
        return 2
    install_root = release.parent.parent
    environment = dict(os.environ)
    environment.pop("VIRTUAL_ENV", None)
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    environment["UV_PROJECT_ENVIRONMENT"] = str(install_root / "environments" / release.name)
    argv = ["uv", "run", "--frozen", "--project", str(release), "devflow", *sys.argv[1:]]
    try:
        os.execvpe(argv[0], argv, environment)
    except OSError as error:
        print(f"devflow: could not launch the installed runtime: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())

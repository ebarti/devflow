      "kind": "flowchart",
      "data": {
        "direction": "LR",
        "nodes": [
          {
            "id": "issues",
            "label": "GitHub issues and dependencies"
          },
          {
            "id": "owner",
            "label": "Visible owner task"
          },
          {
            "id": "roles",
            "label": "Visible review and QA tasks"
          },
          {
            "id": "engine",
            "label": "devflow state and evidence tool"
          },
          {
            "id": "store",
            "label": "Private execution and usage records"
          },
          {
            "id": "checks",
            "label": "Existing checks and product QA"
          },
          {
            "id": "github",
            "label": "PR findings, CI and delivery"
          },
          {
            "id": "usage",
            "label": "ccusage and response records"
